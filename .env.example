# API Config (OpenAI-compatible endpoint)
API_BASE_URL=https://api.993939.xyz/v1
API_KEY=sk-your-api-key

# Market Search Provider
# openai_compatible: reuse API_BASE_URL/API_KEY
# baidu_qianfan: use Baidu intelligent search endpoint below
MARKET_SEARCH_PROVIDER=baidu_qianfan
MARKET_SEARCH_MODEL=

# Baidu Qianfan Market Search
BAIDU_QIANFAN_API_KEY=your-qianfan-api-key
BAIDU_QIANFAN_APP_ID=
BAIDU_QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
BAIDU_QIANFAN_SEARCH_URL=https://qianfan.baidubce.com/v2/ai_search/chat/completions
BAIDU_QIANFAN_SEARCH_MODEL=ernie-4.5-turbo-32k
BAIDU_QIANFAN_SEARCH_SOURCE=baidu_search_v2
BAIDU_QIANFAN_SEARCH_RECENCY=year
BAIDU_QIANFAN_SEARCH_MODE=auto

# Server
BACKEND_PORT=8010
FRONTEND_PORT=3001

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/startup_arena.db

# LLM Models - domestic model pool
MODEL_DEEPSEEK=deepseek-v4-flash
MODEL_GLM=glm-5.1
MODEL_QWEN=qwen3.6-flash
MODEL_KIMI=Kimi-K2.5
MODEL_ERNIE=ernie-x1-turbo-32k

# Agent-Model Mapping - which model alias each role uses
# Supported aliases: deepseek/glm/qwen/kimi/ernie
ROLE_INVESTOR=glm
ROLE_CTO=deepseek
ROLE_USER_REP=kimi
ROLE_COMPETITOR=ernie
ROLE_ORCHESTRATOR=qwen

MAX_DEBATE_ROUNDS=3

# ============================================================
# 双创课堂 / 教师后台
# ============================================================
# 教师登录令牌。设置后即开启 /api/teacher/* 与 /teacher 前端后台。
# 留空则教师后台不可用（学生加入与匿名提交仍正常工作但无班级管理）。
# 强烈建议为生产部署使用 32+ 位随机字符串，例如：openssl rand -hex 24
TEACHER_TOKEN=
