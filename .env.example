# API Config (OpenAI-compatible endpoint)
API_BASE_URL=https://api.993939.xyz/v1
API_KEY=sk-your-api-key

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./startup_arena.db

# LLM Models - available model pool
MODEL_GPT=gpt-4o
MODEL_CLAUDE=claude-sonnet-4-20250514
MODEL_DEEPSEEK=deepseek-chat
MODEL_GEMINI=gemini-2.0-flash
MODEL_GLM=glm-4-flash

# Agent-Model Mapping - which model each role uses (values: gpt/claude/deepseek/gemini/glm)
ROLE_INVESTOR=gpt
ROLE_CTO=deepseek
ROLE_USER_REP=glm
ROLE_COMPETITOR=gemini
ROLE_ORCHESTRATOR=claude

MAX_DEBATE_ROUNDS=3
